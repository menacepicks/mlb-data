name: Props history
# One-off (rerunnable) pull of historical NFL player-prop lines for the props backtest. Run it from the Actions tab.
on:
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  pull:
    runs-on: ubuntu-latest
    timeout-minutes: 300
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests
      - name: Pull historical player props (The Odds API)
        env:
          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
        run: python pull_props_hist.py
      - name: Publish to the "props" release
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          [ -f out/props_hist.json.gz ] || exit 0
          gh release view props >/dev/null 2>&1 || gh release create props --title "Props" --notes "Historical NFL player-prop lines (props_hist.json.gz). Replaced on every run."
          gh release upload props out/props_hist.json.gz --clobber
